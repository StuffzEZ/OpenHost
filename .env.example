# ============================================
# OpenHost Configuration
# ============================================
# Copy this file to .env and update the values
# Many settings can also be configured from the Admin UI after first login.

# Database (REQUIRED - change these!)
POSTGRES_DB=openhost
POSTGRES_USER=openhost
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# JWT Secret (REQUIRED - change this to a random string!)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Admin Account (change after first login!)
ADMIN_EMAIL=admin@openhost.local
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Ports (optional)
HTTP_PORT=80
HTTPS_PORT=443

# DuckDNS (optional - for free subdomains)
DUCKDNS_TOKEN=
DUCKDNS_ROOT_DOMAIN=

# Platform URL (optional - used for webhook URLs and CDN fallback)
# URL=https://your-domain.com

# ============================================
# After first login, configure these from:
# Admin > Platform Settings
# ============================================
# - Platform Name
# - Default Domain (e.g. openhost.com)
# - CDN Domain (e.g. cdn.openhost.com)
# - Registration toggle
# - Approval requirements
# - Database hosts (postgres_host, redis_host, etc.)
# - SMTP email settings
# - Maintenance mode
